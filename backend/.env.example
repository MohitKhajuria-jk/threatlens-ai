# ---------------------------------------------------------------- AI (investigation reports and chat)
# Free key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
# Leave empty for the default (gemini-3.5-flash). A backup model is used automatically when it's busy.
LLM_MODEL=
# LLM_FALLBACK_MODEL=gemini-3.1-flash-lite   ("none" turns the backup off)
# LLM_REASONING_EFFORT=low                   (low | medium | high)
# LLM_TIMEOUT_SECONDS=150

# ---------------------------------------------------------------- Threat intelligence
# Free blocklists (blocklist.de, CINS Army, Emerging Threats, Spamhaus DROP, Tor exits). No key needed.
INTEL_FEEDS_ENABLED=true
# Optional. Free keys: https://www.abuseipdb.com/register (1,000 checks/day) and https://www.virustotal.com/gui/join-us (4/minute, 500/day, personal use)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
# ABUSEIPDB_MAX_PER_ANALYSIS=20

# ---------------------------------------------------------------- Logs
# Timezone for logs without one (Linux syslog, Windows Firewall), e.g. Asia/Kolkata. Empty = this computer's timezone.
LOG_TIMEZONE=
# MAX_UPLOAD_MB=50
# MAX_UNPACKED_MB=200   # how far .gz/.zip uploads may expand
# MAX_CHECK_MB=200      # largest file "Check a file" will hash

# FRONTEND_URL=http://localhost:5173
